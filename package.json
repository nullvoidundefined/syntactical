{
  "name": "syntactical",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "expo start",
    "build": "npm run content:build && expo export --platform web --output-dir dist && cp -R content dist/content && node scripts/copySpaFallback.mjs dist",
    "content:build": "npm run build -w @syntactical/content-schema && tsx scripts/buildContentManifest.mjs",
    "lint": "oxlint",
    "test": "jest",
    "preview": "npx serve dist",
    "test:workspaces": "npm test --workspaces --if-present",
    "typecheck:workspaces": "npm run typecheck --workspaces --if-present",
    "build:workspaces": "npm run build --workspaces --if-present"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/react-query": "^5.104.0",
    "expo": "^57.0.26",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.3",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.24",
    "expo-status-bar": "~57.0.1",
    "nativewind": "^4.2.7",
    "prismjs": "^1.30.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-css-interop": "^0.2.7",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.4",
    "@types/react": "~19.2.4",
    "@types/react-dom": "~19.2.3",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.5",
    "oxlint": "^1.81.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "main": "expo-router/entry",
  "workspaces": [
    "packages/*",
    "pipeline",
    "server"
  ]
}
