      "misconceptions": [
        {
          "description": "Believing nil == false is true, or that nil and false are interchangeable values rather than distinct objects.",
          "id": "ruby.nil-equals-false"
        },
        {
          "description": "Believing procs and lambdas behave identically, missing that lambdas check arity strictly and return only from themselves.",
          "id": "ruby.block-vs-proc-vs-lambda-return"
        },
        {
          "description": "Believing \"a\" + 1 or \"5\" + 5 coerces automatically, rather than raising TypeError and needing to_s or to_i.",
          "id": "ruby.string-plus-integer-coercion"
        },
        {
          "description": "Believing 7 / 2 yields 3.5, rather than integer division truncating toward negative infinity to give 3.",
          "id": "ruby.integer-division-returns-float"
        },
        {
          "description": "Believing ==, eql? and equal? all test the same thing, rather than value equality, type-strict equality, and object identity.",
          "id": "ruby.equal-vs-eql-vs-equal-question"
        },
        {
          "description": "Believing === is a stricter equality operator as in JavaScript, rather than case-subsumption (class membership, regexp match, range inclusion).",
          "id": "ruby.triple-equals-is-strict-equality"
        },
        {
          "description": "Believing `and`/`or` are exact synonyms for &&/||, missing that their much lower precedence changes how assignments parse.",
          "id": "ruby.and-or-same-as-ampersand-pipe"
        },
        {
          "description": "Believing include gives true multiple inheritance with unordered lookup, rather than inserting modules into a defined ancestor chain.",
          "id": "ruby.modules-give-multiple-inheritance"
        }
      ],
