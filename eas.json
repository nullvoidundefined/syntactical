{
  "cli": { "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": { "ADMOB_USE_TEST_IDS": "true" }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "android": { "buildType": "apk" },
      "env": {
        "ADMOB_USE_TEST_IDS": "true",
        "API_BASE_URL": "https://staging-api.syntactical.dev/v1/"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "API_BASE_URL": "https://api.syntactical.dev/v1/"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
